{
  "dxt_version": "0.1",
  "name": "airtable-mcp-server",
  "display_name": "Airtable MCP Server",
  "version": "{{VERSION}}",
  "description": "Read and write access to Airtable databases via the Model Context Protocol (official-aligned v2 tools)",
  "long_description": "A Model Context Protocol server aligned with the official Airtable MCP record and discovery tools. List, search, create, update, and delete records using cellValuesByFieldId; discover bases and tables; fetch full table schemas. Includes schema-admin helpers (create/update tables and fields, get_record). Third-party server, not developed by Airtable.",
  "icon": "icon.png",
  "author": {
    "name": "Adam Jones (domdomegg)",
    "url": "https://github.com/domdomegg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/domdomegg/airtable-mcp-server.git"
  },
  "homepage": "https://github.com/domdomegg/airtable-mcp-server",
  "documentation": "https://github.com/domdomegg/airtable-mcp-server#readme",
  "support": "https://github.com/domdomegg/airtable-mcp-server/issues",
  "keywords": ["airtable", "database", "mcp", "api", "automation", "productivity"],
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "AIRTABLE_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "tools": [
    { "name": "list_records_for_table", "description": "List records (official format)" },
    { "name": "search_records", "description": "Search records by text query" },
    { "name": "get_table_schema", "description": "Get full table schema" },
    { "name": "create_records_for_table", "description": "Create records in a table" },
    { "name": "update_records_for_table", "description": "Update records in a table" },
    { "name": "delete_records_for_table", "description": "Delete records from a table" },
    { "name": "list_bases", "description": "List accessible bases" },
    { "name": "search_bases", "description": "Search bases by name" },
    { "name": "list_tables_for_base", "description": "List tables in a base" },
    { "name": "get_record", "description": "Get a record by ID" },
    { "name": "create_table", "description": "Create a table" },
    { "name": "update_table", "description": "Update a table" },
    { "name": "create_field", "description": "Create a field" },
    { "name": "update_field", "description": "Update a field" }
  ],
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=16.0.0"
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "Airtable API Key",
      "description": "Your Airtable personal access token. Should have at least schema.bases:read and data.records:read permissions, and optionally the corresponding write permissions.",
      "sensitive": true,
      "required": true
    }
  }
}
